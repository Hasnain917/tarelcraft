{% comment %}
  ==========================================================================
  TARELCRAFT SHOPIFY 2.0 BALANCED PROFESSIONAL SECTION (WITH WHATSAPP CONCIERGE & CHAT SIMULATOR)
  Paste into: Shopify Admin -> Themes -> Edit code -> Sections -> tarelcraft-product.liquid
  ==========================================================================
{% endcomment %}

<!-- Load FontAwesome 6 for Clean Professional Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="tc-shopify-section-root" style="background-color: {{ section.settings.bg_color | default: '#f8fafc' }};">
  <div class="tc-shopify-container">

    {% for block in section.blocks %}
      {% case block.type %}

        {% comment %} =========================================================
             WIDGET 2: PRODUCT HERO & BALANCED BUY BOX
             ========================================================= {% endcomment %}
        {% when 'product_hero' %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          {% assign hero_title = block.settings.product_title %}
          {% if hero_title == blank and product.title != blank %}
            {% assign hero_title = product.title %}
          {% elsif hero_title == blank %}
            {% assign hero_title = "Handcrafted Custom 'MINI ME' Figurine & Bobblehead" %}
          {% endif %}

          {% assign hero_subtitle = block.settings.product_subtitle %}
          {% if hero_subtitle == blank and product.description != blank %}
            {% assign hero_subtitle = product.description | truncatewords: 25 %}
          {% elsif hero_subtitle == blank %}
            {% assign hero_subtitle = "Turn any photo into a detailed personalized keepsake. Sculpted with high-detail polymer clay." %}
          {% endif %}

          {% assign primary_img = current_variant.image | default: current_variant.featured_image | default: product.featured_image %}
          {% if primary_img == blank %}
            {% assign primary_img_url = 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=1000&q=80' %}
          {% else %}
            {% assign primary_img_url = primary_img | image_url: width: 1000 %}
          {% endif %}

          <div class="tc-card-box tc-hero-card tc-hero-single-col" {{ block.shopify_attributes }}>
            <div class="tc-info-side tc-info-centered">
              <div class="tc-stars-row">
                  <span class="tc-stars">★★★★★</span>
                  <span class="tc-stars-text"><strong>4.9 / 5.0</strong> &bull; 1,480+ Reviews</span>
                </div>

                <h1 class="tc-product-title">{{ hero_title }}</h1>
                <p class="tc-product-subtitle">{{ hero_subtitle }}</p>

                <!-- Pricing Display -->
                <div class="tc-price-box">
                  <span class="tc-price-main" id="tc-live-price">
                    {% if current_variant.price %}
                      {{ current_variant.price | money }}
                    {% else %}
                      {{ block.settings.currency }} {{ block.settings.base_price }}
                    {% endif %}
                  </span>
                  <span class="tc-price-comp" id="tc-live-compare">
                    {% if current_variant.compare_at_price %}
                      {{ current_variant.compare_at_price | money }}
                    {% else %}
                      {{ block.settings.currency }} {{ block.settings.compare_price }}
                    {% endif %}
                  </span>
                  <span class="tc-discount-pill">50% OFF</span>
                </div>

                <!-- 60-Second Photo Assurance Banner -->
                <div class="tc-whatsapp-inline-notice" style="background:#FFFDF7; border:1.5px solid #F1D4A7; border-radius:14px; padding:14px 16px;">
                  <div class="tc-wa-notice-icon" style="background:rgba(201,151,66,0.15); color:#B47318;"><i class="fa-solid fa-bolt-lightning"></i></div>
                  <div class="tc-wa-notice-text">
                    <strong style="color:#121417; text-transform:uppercase;">Create Your Mini Me In <span style="color:#B47318;">60 Seconds</span>:</strong>
                    <span>Upload photos after checkout — we'll send you the link.</span>
                  </div>
                </div>

                <form method="post" action="/cart/add" id="tc-shopify-buy-form">
                  <input type="hidden" name="id" id="tc-selected-variant-id" value="{{ current_variant.id | default: product.variants.first.id }}">
                  <input type="hidden" name="properties[Size]" id="tc-selected-size-val" value="18cm">
                  <input type="hidden" name="properties[Head Style]" id="tc-selected-head-val" value="BobbleHead">

                  <!-- Option 1: Figures (Shopify Variations) -->
                  <div class="tc-option-group">
                    <div class="tc-opt-head">
                      <span class="tc-opt-title">1. Figure Type</span>
                      <span class="tc-opt-selected" id="tc-val-figure">{{ current_variant.title | default: 'Single Person' }}</span>
                    </div>
                    <div class="tc-selector-grid cols-4">
                      {% if product.variants.size > 0 %}
                        {% for variant in product.variants %}
                          {% assign v_img = variant.image | default: variant.featured_image | default: product.featured_image %}
                          {% if v_img == blank %}
                            {% assign v_img_url = 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=800&q=80' %}
                          {% else %}
                            {% assign v_img_url = v_img | image_url: width: 1000 %}
                          {% endif %}
                          <button type="button" class="tc-variant-card {% if forloop.first %}active{% endif %}"
                                  data-variant-id="{{ variant.id }}"
                                  data-variant-title="{{ variant.title | escape }}"
                                  data-variant-price="{{ variant.price | money }}"
                                  data-variant-compare="{{ variant.compare_at_price | money }}"
                                  data-img="{{ v_img_url }}">
                            <strong>{{ variant.title }}</strong>
                            <span>{{ variant.price | money }}</span>
                          </button>
                        {% endfor %}
                      {% else %}
                        <button type="button" class="tc-variant-card active" data-variant-title="Single Person" data-variant-price="$59.88" data-img="https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=800&q=80">
                          <strong>Single Person</strong>
                          <span>Included</span>
                        </button>
                        <button type="button" class="tc-variant-card" data-variant-title="Couple" data-variant-price="$89.88" data-img="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=800&q=80">
                          <strong>Couple</strong>
                          <span>+ $30</span>
                        </button>
                        <button type="button" class="tc-variant-card" data-variant-title="With Pet" data-variant-price="$74.88" data-img="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=800&q=80">
                          <strong>With Pet</strong>
                          <span>+ $15</span>
                        </button>
                        <button type="button" class="tc-variant-card" data-variant-title="Family Group" data-variant-price="$119.88" data-img="https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=800&q=80">
                          <strong>Family</strong>
                          <span>+ $60</span>
                        </button>
                      {% endif %}
                    </div>
                  </div>

                  <!-- Option 2: Visual Size Selection -->
                  <div class="tc-option-group">
                    <div class="tc-opt-head">
                      <span class="tc-opt-title">Size</span>
                      <span class="tc-opt-selected" id="tc-val-height">18cm (Included)</span>
                    </div>
                    <div class="visual-size-grid" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:10px;">
                      <button type="button" class="visual-size-card active" data-height="18cm">
                        <div class="card-check-badge"><i class="fa-solid fa-check"></i></div>
                        <div class="size-graphic-wrapper"><img src="https://tarelcraft.vercel.app/assets/images/variant-size-18cm.svg" alt="18cm" style="height:90px;"></div>
                        <div class="size-card-info">
                          <h4 class="size-title">18cm</h4>
                          <span class="size-price-tag included" style="color:#B47318; font-weight:700; font-size:0.8rem;">Included</span>
                        </div>
                      </button>
                      <button type="button" class="visual-size-card" data-height="20cm">
                        <span class="floating-pill-badge popular-badge">POPULAR</span>
                        <div class="card-check-badge"><i class="fa-solid fa-check"></i></div>
                        <div class="size-graphic-wrapper"><img src="https://tarelcraft.vercel.app/assets/images/variant-size-20cm.svg" alt="20cm" style="height:100px;"></div>
                        <div class="size-card-info">
                          <h4 class="size-title">20cm</h4>
                          <span class="size-price-tag extra" style="color:#5F6773; font-weight:700; font-size:0.8rem;">+ $12</span>
                        </div>
                      </button>
                      <button type="button" class="visual-size-card" data-height="22cm">
                        <div class="card-check-badge"><i class="fa-solid fa-check"></i></div>
                        <div class="size-graphic-wrapper"><img src="https://tarelcraft.vercel.app/assets/images/variant-size-22cm.svg" alt="22cm" style="height:108px;"></div>
                        <div class="size-card-info">
                          <h4 class="size-title">22cm</h4>
                          <span class="size-price-tag extra" style="color:#5F6773; font-weight:700; font-size:0.8rem;">+ $24</span>
                          <span class="size-subtag" style="color:#B47318; font-size:0.72rem; font-weight:700;">Most lifelike</span>
                        </div>
                      </button>
                    </div>
                  </div>

                  <!-- Option 3: Visual Head Style -->
                  <div class="tc-option-group">
                    <div class="tc-opt-head">
                      <span class="tc-opt-title">Head style</span>
                      <span class="tc-opt-selected" id="tc-val-head">BobbleHead (+ $12)</span>
                    </div>
                    <div class="visual-head-grid" style="display:grid; grid-template-columns:repeat(2, 1fr); gap:12px;">
                      <button type="button" class="visual-head-card" data-head="fixed">
                        <div class="card-check-badge"><i class="fa-solid fa-check"></i></div>
                        <div class="head-graphic-wrapper"><img src="https://tarelcraft.vercel.app/assets/images/variant-head-fixed.svg" alt="Fixed Head" style="width:68px;"></div>
                        <div class="head-card-info">
                          <h4 class="head-title">Fixed Head</h4>
                          <p class="head-desc" style="font-size:0.75rem; color:#5F6773;">Head stays fixed.</p>
                          <span class="head-price-tag included" style="color:#B47318; font-weight:700; font-size:0.8rem;">Included</span>
                        </div>
                      </button>
                      <button type="button" class="visual-head-card active" data-head="bobblehead">
                        <span class="floating-pill-badge customer-favorite-badge"><i class="fa-solid fa-star"></i> CUSTOMER FAVORITE</span>
                        <div class="card-check-badge"><i class="fa-solid fa-check"></i></div>
                        <div class="head-graphic-wrapper is-wobbling"><img src="https://tarelcraft.vercel.app/assets/images/variant-head-bobble.svg" alt="BobbleHead" class="head-char-img bobble-anim" style="width:68px;"></div>
                        <div class="head-card-info">
                          <h4 class="head-title">BobbleHead</h4>
                          <p class="head-desc" style="font-size:0.75rem; color:#5F6773;">Moves naturally when touched.</p>
                          <span class="head-price-tag extra" style="color:#B47318; font-weight:700; font-size:0.8rem;">+ $12</span>
                        </div>
                      </button>
                    </div>
                  </div>

                  <!-- Option 4: Engraving -->
                  <div class="tc-option-group">
                    <div class="tc-opt-head">
                      <span class="tc-opt-title">Free Base Engraving (Optional)</span>
                      <span style="font-size:0.8rem; color:#059669; font-weight:600;">100% Free</span>
                    </div>
                    <input type="text" name="properties[Engraving]" id="tc-engrave-input-field" class="tc-form-input" placeholder="e.g. 'Best Dad Ever • 2026' or Family Name" maxlength="30">
                  </div>

                  <!-- Trust Summary Badges -->
                  <div class="config-trust-badges-row" style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:14px 0 6px;">
                    <div class="trust-badge-pill" style="background:#F0FDF4; border:1px solid #BBF7D0; color:#166534; padding:8px; border-radius:10px; font-size:0.72rem; font-weight:800; display:flex; align-items:center; justify-content:center; gap:6px;">
                      <i class="fa-solid fa-circle-check" style="color:#10B981;"></i>
                      <span>FREE WHATSAPP PREVIEW</span>
                    </div>
                    <div class="trust-badge-pill" style="background:#F0FDF4; border:1px solid #BBF7D0; color:#166534; padding:8px; border-radius:10px; font-size:0.72rem; font-weight:800; display:flex; align-items:center; justify-content:center; gap:6px;">
                      <i class="fa-solid fa-circle-check" style="color:#10B981;"></i>
                      <span>UNLIMITED REVISIONS</span>
                    </div>
                  </div>

                  <!-- Action Buttons -->
                  <div class="tc-action-block">
                    <button type="submit" class="tc-main-buy-button" id="tc-buy-now-trigger">
                      <i class="fa-solid fa-bag-shopping"></i> {{ block.settings.btn_text | default: 'Customize & Order Now' }}
                    </button>
                    <p class="tc-buy-subtext"><i class="fa-brands fa-whatsapp text-emerald"></i> No photos required now &bull; Submit anytime after checkout</p>
                    
                    </div>
                  </div>

                </form>
              </div>
            </div>

        {% comment %} =========================================================
             WIDGET 3: 3-STEP WHATSAPP ORDER PROCESS
             ========================================================= {% endcomment %}
        {% when 'whatsapp_guarantee' %}
          <div class="tc-card-box tc-steps-section" id="how-it-works" {{ block.shopify_attributes }}>
            <div class="tc-section-header">
              <span class="tc-badge-eyebrow"><i class="fa-brands fa-whatsapp"></i> STRESS-FREE PROCESS</span>
              <h2 class="tc-section-title">{{ block.settings.heading }}</h2>
              <p class="tc-section-desc">{{ block.settings.subheading }}</p>
            </div>

            <div class="tc-steps-columns">
              <div class="tc-step-card">
                <div class="tc-step-num">1</div>
                <h3>1. Select Options & Order</h3>
                <p>Choose your figure type and checkout. <strong>No photo rush:</strong> You don't need photos during payment!</p>
                <div class="tc-step-badge-tag"><i class="fa-solid fa-check text-emerald"></i> Zero Photo Stress</div>
              </div>
              <div class="tc-step-card tc-step-highlight">
                <div class="tc-step-num" style="background:#059669;">2</div>
                <h3>2. WhatsApp Photo Concierge</h3>
                <p>You receive an instant dedicated WhatsApp link. Send your favorite photos whenever you are ready at your pace.</p>
                <div class="tc-step-badge-tag"><i class="fa-brands fa-whatsapp text-emerald"></i> Dedicated WhatsApp Chat</div>
              </div>
              <div class="tc-step-card">
                <div class="tc-step-num">3</div>
                <h3>3. 360° Preview & Revisions</h3>
                <p>Inspect clay model photos on WhatsApp. Request <strong>100% Free Revisions</strong> until you approve before kiln baking.</p>
                <div class="tc-step-badge-tag"><i class="fa-solid fa-rotate-left text-blue"></i> Unlimited Revisions</div>
              </div>
            </div>
          </div>

        {% comment %} =========================================================
             WIDGET 4: WHATSAPP 3D PREVIEW CHAT SIMULATOR MOCKUP
             ========================================================= {% endcomment %}
        {% when 'whatsapp_chat' %}
          <div class="tc-card-box tc-wa-chat-widget" {{ block.shopify_attributes }}>
            <div class="tc-section-header">
              <span class="tc-badge-eyebrow"><i class="fa-brands fa-whatsapp"></i> LIVE EXPERIENCE</span>
              <h2 class="tc-section-title">{{ block.settings.heading | default: 'See How WhatsApp Approval Works' }}</h2>
              <p class="tc-section-desc">Here is a real preview of how our master sculptor collaborates with you directly on WhatsApp.</p>
            </div>

            <div class="tc-wa-phone-container">
              <div class="tc-wa-phone-mockup">
                <!-- WhatsApp Top Header -->
                <div class="tc-wa-chat-header">
                  <div class="tc-wa-chat-avatar">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Sculptor">
                    <span class="tc-wa-online-dot"></span>
                  </div>
                  <div class="tc-wa-chat-info">
                    <strong>Tarelcraft Master Sculptor <i class="fa-solid fa-circle-check text-emerald" style="font-size:0.75rem;"></i></strong>
                    <span>Online &bull; WhatsApp 3D Preview Concierge</span>
                  </div>
                </div>

                <!-- WhatsApp Chat Messages Body -->
                <div class="tc-wa-chat-body">
                  <div class="tc-wa-date-pill">Today &bull; Order #TC-8942</div>

                  <!-- Msg 1 (Sculptor) -->
                  <div class="tc-wa-bubble tc-wa-incoming">
                    <p>Hello Sarah! 👋 Here are the 360° photos of your clay figurine before kiln baking. How does the resemblance and haircut look?</p>
                    <div class="tc-wa-msg-photos">
                      <img src="https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=400&q=80" alt="Clay Preview 1">
                      <img src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=400&q=80" alt="Clay Preview 2">
                    </div>
                    <span class="tc-wa-time">10:14 AM</span>
                  </div>

                  <!-- Msg 2 (Customer) -->
                  <div class="tc-wa-bubble tc-wa-outgoing">
                    <p>Wow it looks amazing!! 😍 Could we make my husband's smile just a tiny bit wider?</p>
                    <span class="tc-wa-time">10:18 AM <i class="fa-solid fa-check-double text-blue"></i></span>
                  </div>

                  <!-- Msg 3 (Sculptor) -->
                  <div class="tc-wa-bubble tc-wa-incoming">
                    <p>Adjusted with pleasure! Here is the updated smile. Baking in the kiln now for final painting! ✨</p>
                    <span class="tc-wa-time">11:05 AM</span>
                  </div>

                  <!-- Msg 4 (Customer) -->
                  <div class="tc-wa-bubble tc-wa-outgoing">
                    <p>100% PERFECT! You guys are true artists! Thank you so much! 🎉</p>
                    <span class="tc-wa-time">11:08 AM <i class="fa-solid fa-check-double text-blue"></i></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

        {% comment %} =========================================================
             WIDGET 5: REAL UGC VIDEO REELS (CLEAN BOX LAYOUT)
             ========================================================= {% endcomment %}
        {% when 'video_reels' %}
          <div class="tc-card-box tc-reels-section" {{ block.shopify_attributes }}>
            <div class="tc-section-header">
              <span class="tc-badge-eyebrow">REAL CUSTOMER MOMENTS</span>
              <h2 class="tc-section-title">{{ block.settings.heading | default: 'Real Unboxing Moments' }}</h2>
              <p class="tc-section-desc">Watch genuine customer reactions opening their custom figurines.</p>
            </div>

            <div class="tc-reels-box-grid">
              
              <!-- Video Reel Box 1 -->
              <div class="tc-reel-box-card">
                <div class="tc-reel-box-media">
                  <video class="tc-reel-video" playsinline loop preload="metadata" poster="https://images.unsplash.com/photo-1513151233558-d860c5398176?auto=format&fit=crop&w=600&q=80">
                    <source src="https://tarelcraft.com/cdn/shop/videos/c/vp/60f6bbcf350f44228c57ce5410424d05/60f6bbcf350f44228c57ce5410424d05.HD-1080p-7.2Mbps-50901326.mp4?v=0" type="video/mp4">
                  </video>
                  <button type="button" class="tc-video-play-btn" aria-label="Play video"><i class="fa-solid fa-play"></i></button>
                  <span class="tc-reel-badge"><i class="fa-solid fa-circle-check"></i> Verified Buyer</span>
                </div>
                <div class="tc-reel-box-info">
                  <div class="tc-reel-box-stars">★★★★★</div>
                  <h4 class="tc-reel-box-name">Emily R. &bull; Zurich</h4>
                  <p class="tc-reel-box-text">"WhatsApp preview was so reassuring! Resemblance blew me away!"</p>
                </div>
              </div>

              <!-- Video Reel Box 2 -->
              <div class="tc-reel-box-card">
                <div class="tc-reel-box-media">
                  <video class="tc-reel-video" playsinline loop preload="metadata" poster="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=600&q=80">
                    <source src="https://tarelcraft.com/cdn/shop/videos/c/vp/ea4909b6b23b4e46875a3cc0b2c6970a/ea4909b6b23b4e46875a3cc0b2c6970a.HD-1080p-7.2Mbps-83368704.mp4?v=0" type="video/mp4">
                  </video>
                  <button type="button" class="tc-video-play-btn" aria-label="Play video"><i class="fa-solid fa-play"></i></button>
                  <span class="tc-reel-badge"><i class="fa-solid fa-circle-check"></i> Verified Buyer</span>
                </div>
                <div class="tc-reel-box-info">
                  <div class="tc-reel-box-stars">★★★★★</div>
                  <h4 class="tc-reel-box-name">Liam & Sarah &bull; Bern</h4>
                  <p class="tc-reel-box-text">"Uploaded photos after order. Best anniversary gift ever!"</p>
                </div>
              </div>

              <!-- Video Reel Box 3 -->
              <div class="tc-reel-box-card">
                <div class="tc-reel-box-media">
                  <video class="tc-reel-video" playsinline loop preload="metadata" poster="https://images.unsplash.com/photo-1512909006721-3d6018887383?auto=format&fit=crop&w=600&q=80">
                    <source src="https://tarelcraft.com/cdn/shop/videos/c/vp/ea8367eefbb84d70925e3c9160f73a6a/ea8367eefbb84d70925e3c9160f73a6a.HD-1080p-7.2Mbps-86226255.mp4?v=0" type="video/mp4">
                  </video>
                  <button type="button" class="tc-video-play-btn" aria-label="Play video"><i class="fa-solid fa-play"></i></button>
                  <span class="tc-reel-badge"><i class="fa-solid fa-circle-check"></i> Verified Buyer</span>
                </div>
                <div class="tc-reel-box-info">
                  <div class="tc-reel-box-stars">★★★★★</div>
                  <h4 class="tc-reel-box-name">Sarah for Dad &bull; Geneva</h4>
                  <p class="tc-reel-box-text">"Dad cried tears of joy! Artist adjusted hair on WhatsApp."</p>
                </div>
              </div>

            </div>
          </div>

        {% comment %} =========================================================
             WIDGET 6: REVIEWS
             ========================================================= {% endcomment %}
        {% when 'reviews' %}
          <div class="tc-card-box tc-reviews-section" {{ block.shopify_attributes }}>
            <div class="tc-section-header">
              <span class="tc-badge-eyebrow">TESTIMONIALS</span>
              <h2 class="tc-section-title">{{ block.settings.heading }}</h2>
            </div>

            <div class="tc-reviews-columns">
              <div class="tc-review-box">
                <div class="tc-rev-header">
                  <div class="tc-rev-initials">MS</div>
                  <div>
                    <strong>Marc & Elena S.</strong>
                    <span class="tc-rev-city">Zurich &bull; Verified</span>
                  </div>
                  <div class="tc-rev-stars">★★★★★</div>
                </div>
                <p class="tc-rev-quote">"The sculptor captured our exact dimples and smile from our vacation photo! 100% peace of mind on WhatsApp."</p>
              </div>
              <div class="tc-review-box">
                <div class="tc-rev-header">
                  <div class="tc-rev-initials">PB</div>
                  <div>
                    <strong>Pascal B.</strong>
                    <span class="tc-rev-city">Geneva &bull; Verified</span>
                  </div>
                  <div class="tc-rev-stars">★★★★★</div>
                </div>
                <p class="tc-rev-quote">"Ordered during commute and sent photos on WhatsApp. Master sculptor replied within 48h with HD photos."</p>
              </div>
              <div class="tc-review-box">
                <div class="tc-rev-header">
                  <div class="tc-rev-initials">CM</div>
                  <div>
                    <strong>Corinne M.</strong>
                    <span class="tc-rev-city">Lucerne &bull; Verified</span>
                  </div>
                  <div class="tc-rev-stars">★★★★★</div>
                </div>
