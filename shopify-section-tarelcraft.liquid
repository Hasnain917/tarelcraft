{% comment %} =========================================================
     JAVASCRIPT LOGIC
     ========================================================= {% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mainImg = document.getElementById('tc-active-hero-img');
    const priceEl = document.getElementById('tc-live-price');
    const compareEl = document.getElementById('tc-live-compare');
    const figureLabel = document.getElementById('tc-val-figure');
    const headLabel = document.getElementById('tc-val-head');
    const heightLabel = document.getElementById('tc-val-height');
    const variantInput = document.getElementById('tc-selected-variant-id');

    // 1. Figure Type Selection
    const figureCards = document.querySelectorAll('.tc-variant-card[data-variant-title]');
    figureCards.forEach(card => {
      card.addEventListener('click', function(e) {
        e.preventDefault();
        figureCards.forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        const title = this.getAttribute('data-variant-title');
        const vId = this.getAttribute('data-variant-id');
        const price = this.getAttribute('data-variant-price');
        const compare = this.getAttribute('data-variant-compare');
        if (figureLabel && title) figureLabel.textContent = title;
        if (variantInput && vId) variantInput.value = vId;
        if (priceEl && price) priceEl.textContent = price;
        if (compareEl && compare) compareEl.textContent = compare;
      });
    });

    // 2. Size Selection
    const sizeCards = document.querySelectorAll('.visual-size-card[data-height]');
    const sizeInput = document.getElementById('tc-selected-size-val');
    sizeCards.forEach(card => {
      card.addEventListener('click', function(e) {
        e.preventDefault();
        sizeCards.forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        const height = this.getAttribute('data-height');
        const titleEl = this.querySelector('.size-title');
        const priceTag = this.querySelector('.size-price-tag');
        const labelText = (titleEl ? titleEl.textContent : height) + (priceTag ? ' (' + priceTag.textContent.trim() + ')' : '');
        if (heightLabel) heightLabel.textContent = labelText;
        if (sizeInput) sizeInput.value = height;
      });
    });

    // 3. Head Style Selection
    const headCards = document.querySelectorAll('.visual-head-card[data-head]');
    const headInput = document.getElementById('tc-selected-head-val');
    headCards.forEach(card => {
      card.addEventListener('click', function(e) {
        e.preventDefault();
        headCards.forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        const head = this.getAttribute('data-head');
        const titleEl = this.querySelector('.head-title');
        const priceTag = this.querySelector('.head-price-tag');
        const labelText = (titleEl ? titleEl.textContent : head) + (priceTag ? ' (' + priceTag.textContent.trim() + ')' : '');
        if (headLabel) headLabel.textContent = labelText;
        if (headInput) headInput.value = head === 'bobblehead' ? 'BobbleHead' : 'Fixed Head';

        // Wobble Animation trigger
        const bobbleImg = this.querySelector('.bobble-anim, .head-char-img');
        if (bobbleImg && head === 'bobblehead') {
          bobbleImg.classList.remove('bobble-anim');
          void bobbleImg.offsetWidth;
          bobbleImg.classList.add('bobble-anim');
        }
      });
    });

    // Video Reels Play/Pause Click Handler
    const videoMedias = document.querySelectorAll('.tc-reel-box-media');
    videoMedias.forEach(container => {
      const video = container.querySelector('.tc-reel-video');
      if (video) {
        container.addEventListener('click', function() {
          if (video.paused) {
            document.querySelectorAll('.tc-reel-video').forEach(v => {
              if (v !== video) {
                v.pause();
                v.closest('.tc-reel-box-media').classList.remove('playing');
              }
            });
            video.play();
            container.classList.add('playing');
          } else {
            video.pause();
            container.classList.remove('playing');
          }
        });
      }
    });

  });
</script>

